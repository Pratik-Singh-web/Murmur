# Copy to .env and fill in. Never commit .env.

# Sarvam workspace (console URL / settings)
SARVAM_ORG_ID=
SARVAM_WORKSPACE_ID=
SARVAM_API_KEY=
# Header name for the API key — confirm in the Sarvam console; Sarvam APIs commonly use this one
SARVAM_AUTH_HEADER=api-subscription-key

# Telephony (Sarvam → Telephony / Connections)
SARVAM_CONNECTION_ID=
SARVAM_AGENT_PHONE=+91XXXXXXXXXX

# Agent variants (Sarvam → Agents → each agent's id and committed version)
SARVAM_APP_ID_WARM=
SARVAM_APP_VERSION_WARM=1
SARVAM_APP_ID_FORMAL=
SARVAM_APP_VERSION_FORMAL=1
SARVAM_APP_ID_BRISK=
SARVAM_APP_VERSION_BRISK=1
SARVAM_APP_ID_BASELINE=
SARVAM_APP_VERSION_BASELINE=1

# Murmur service
MURMUR_TOKEN=pick-a-long-random-string
# Public tunnel URL to this service, e.g. https://abcd.ngrok-free.app
MURMUR_PUBLIC_URL=
